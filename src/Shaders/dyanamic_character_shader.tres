[gd_resource type="Shader" format=3 uid="uid://ddfypiealb4pm"]

[resource]
code = "shader_type spatial;
render_mode world_vertex_coords, ambient_light_disabled;

uniform sampler2D albedo_texture : hint_default_white, filter_nearest;
uniform vec4 albedo_color : source_color = vec4(1);
uniform vec2 UVScaling = vec2(1);

uniform float distance_fade_min : hint_range(0.0, 4096.0, 0.01);
uniform float distance_fade_max : hint_range(0.0, 4096.0, 0.01);

global uniform sampler2D light_texture : repeat_disable;
global uniform vec3 light_direction;
global uniform vec4 ambient_tint;

uniform sampler2D probe1 : hint_default_black;
uniform sampler2D probe2 : hint_default_black;
uniform vec3 probe1Direction = vec3(0,1,0);
uniform vec3 probe2Direction = vec3(0,1,0);

uniform float probe1Blend : hint_range(0.0, 1.0, 0.1) = 0.0;
uniform float probe2Blend : hint_range(0.0, 1.0, 0.1) = 0.0;

varying vec3 ambientLight;

void vertex()
{
	UV *= UVScaling;
	ambientLight = textureLod(light_texture, vec2(dot(NORMAL, light_direction) * 0.5 + 0.5,0.5),0).rgb;
	vec3 probeBlend = mix(textureLod(probe1,vec2(dot(NORMAL, probe1Direction) * 0.5 + 0.5,0.5),0).rgb,textureLod(probe2,vec2(dot(NORMAL, probe2Direction) * 0.5 + 0.5,0.5),0).rgb, max(0,probe2Blend - probe1Blend * 0.5)).rgb;
	ambientLight = mix(ambientLight, probeBlend, min(probe1Blend + probe2Blend,1.0));
}

void fragment()
{
	ALBEDO = texture(albedo_texture, UV).rgb * albedo_color.rgb;
	EMISSION = ALBEDO * ambientLight * ambient_tint.rgb;
	{
		// Distance Fade: Pixel Dither
		float fade_distance = length(VERTEX);

		// Use interleaved gradient noise, which is fast but still looks good.
		const vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
		float fade = clamp(smoothstep(distance_fade_min, distance_fade_max, fade_distance), 0.0, 1.0);
		// Use a hard cap to prevent a few stray pixels from remaining when past the fade-out distance.
		if (fade < 0.001 || fade < fract(magic.z * fract(dot(FRAGCOORD.xy, magic.xy)))) {
			discard;
		}
	}
}

//void light() {
//	// Called for every pixel for every light affecting the material.
//	// Uncomment to replace the default light processing function with this one.
//}
"
