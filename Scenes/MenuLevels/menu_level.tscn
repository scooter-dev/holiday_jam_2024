[sub_resource type="GDScript" id="GDScript_oa8tn"]
script/source = "extends Node3D

@export var platforms : Node3D
@export var water : Node3D
@export var leaves : Node3D
@export var launchPad : JumpPad

@export var platformCovers : Node3D
@export var waterCovers : Node3D
@export var leafCovers : Node3D

func _ready() -> void:
	remove_child(platforms)
	remove_child(water)
	remove_child(leaves)

func enablePlatforms() -> void:
	add_child(platforms)
	platformCovers.queue_free()

func enableWater() -> void:
	add_child(water)
	waterCovers.queue_free()

func enableLeaves() -> void:
	add_child(leaves)
	leafCovers.queue_free()

func enablePad() -> void:
	launchPad.enabled = true

func _on_leaf_card_picked_up(card: GlitchCard) -> void:
	enableLeaves()


func _on_plat_card_picked_up(card: GlitchCard) -> void:
	enablePlatforms()


func _on_water_card_picked_up(card: GlitchCard) -> void:
	enableWater()


func _on_pad_card_picked_up(card: GlitchCard) -> void:
	enablePad()
"

