tracks/16/type = "method"
tracks/16/imported = false
tracks/16/enabled = true
tracks/16/path = NodePath("CutscenePlayer")
tracks/16/interp = 1
tracks/16/loop_wrap = true
tracks/16/keys = {
"times": PackedFloat32Array(0, 4, 8, 12, 16, 20, 24, 28),
"transitions": PackedFloat32Array(1, 1, 1, 1, 1, 1, 1, 1),
"values": [{
"args": ["Hello brave warror! You must be curious as to why you have been summoned."],
"method": &"displayDialog"
}, {
"args": ["I am BIOS, the one responsible for maintaining all of the worlds within this plane of existance."],
"method": &"displayDialog"
}, {
"args": ["A plague called bit_rot is spreading throughout my system."],
"method": &"displayDialog"
}, {
"args": ["The saves, snapshots of the many worlds, are where the corruption hid its integral pieces."],
"method": &"displayDialog"
}, {
"args": ["You must go and recover the pieces of the corruption in each save."],
"method": &"displayDialog"
}, {
"args": ["Then bring them to the IO system so that I may expell it."],
"method": &"displayDialog"
}, {
"args": ["Now go! The save system is open for you."],
"method": &"displayDialog"
}, {
"args": [],
"method": &"closeDialog"
}]
}

