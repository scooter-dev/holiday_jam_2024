[sub_resource type="GDScript" id="GDScript_4pm6c"]
script/source = "extends Node3D

@export var player : Player
@export var shootPosition : Node3D
@export var exclude : Array[RID]
@export var activated : bool = false

@export var shootTimer : float = 1.0
enum e_state {AIM, LOCK, FIRE, RELOAD}
@export var state : e_state = e_state.AIM
func _physics_process(delta: float) -> void:
	if activated:
		match state:
			e_state.AIM:
				#aim((player.global_position + Vector3(0,0.5,0)))
				if shootTimer > 0.001:
					shootTimer = max(0, shootTimer - delta)
				else:
					shootTimer = randf_range(0.3,0.5)
					tgtPos = (player.global_position + Vector3(0,0.5,0))
					state = e_state.LOCK
			e_state.LOCK:
				aim(tgtPos)
				if shootTimer > 0.001:
					shootTimer = max(0, shootTimer - delta)
				else:
					state = e_state.FIRE
			e_state.FIRE:
				shootTimer = 0.3
				state = e_state.RELOAD
				shoot()
			e_state.RELOAD:
				if shootTimer > 0.001:
					shootTimer = max(0, shootTimer - delta)
				else:
					shootTimer = randf_range(0.5,1.5)
					state = e_state.AIM

const LASER = preload(\"res://src/LevelActors/Enemies/OS/laser.tscn\")

var ray : PhysicsRayQueryParameters3D

func _ready() -> void:
	ray = PhysicsRayQueryParameters3D.new()
	ray.collision_mask = 3
	ray.exclude = exclude.duplicate()

var tgtPos : Vector3

func aim(pos : Vector3) -> void:
	ray.from = shootPosition.global_position
	ray.to = shootPosition.global_position + (pos - shootPosition.global_position).normalized() * 200.0
	var res : Dictionary = get_world_3d().direct_space_state.intersect_ray(ray)
	var laser : Laser = LASER.instantiate()
	laser.pointA = shootPosition.global_position
	laser.lifeTime = 0.02
	laser.laserColor = Color.ORANGE
	if res.has(\"position\"):
		laser.pointB = res.position
	else:
		laser.pointB = ray.to
	add_child(laser)

func shoot() -> void:
	ray.from = shootPosition.global_position
	ray.to = shootPosition.global_position + (tgtPos - shootPosition.global_position).normalized() * 200.0
	var res : Dictionary = get_world_3d().direct_space_state.intersect_ray(ray)
	var laser : Laser = LASER.instantiate()
	laser.pointA = shootPosition.global_position
	laser.laserColor = Color.RED
	laser.lifeTime = 0.3
	if res.has(\"position\"):
		laser.pointB = res.position
	else:
		laser.pointB = ray.to
	if res.has(\"collider\") and res.collider is Player:
		player.die()
	add_child(laser)


func _on_player_player_died() -> void:
	shootTimer = 4.0
	state = e_state.RELOAD
"

