[sub_resource type="GDScript" id="GDScript_hby8t"]
script/source = "extends AnimationPlayer

@export var player : Player
@export var playerPos : Node3D
@export var interactable: Interactable


func startCutscene() -> void:
	player.suspend()
	player.reparent(playerPos)
	player.position = Vector3()
	player.rotation = Vector3()
	play(\"ExitCutscene\")

func loadNextLevel() -> void:
	LevelManager.changeLevel(\"res://Scenes/MenuLevels/menu_level.tscn\")


func _on_interactable_interacted(interactor: Interactor) -> void:
	startCutscene()
	interactable.disable()
"

