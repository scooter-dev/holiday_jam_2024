[sub_resource type="GDScript" id="GDScript_a5o3l"]
script/source = "extends MeshInstance3D

var timer : float = 0.0
func _physics_process(delta: float) -> void:
	timer = timer + delta if timer < PI * 4.0 else 0.0
	position.y = -4.12 + sin(timer) * 0.1
	rotation.z = cos(timer) * 0.1
